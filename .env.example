# CatchyPills Personal & Bespoke Integrations Configuration
# Copy to ~/.config/catchypills/.env (recommended) or configure via
# Settings -> Bespoke Integrations (Advanced). Changes save with 0600 permissions.

# ---------------------------------------------------------------------------
# ServiceNow ITSM (enableITSM)
# ---------------------------------------------------------------------------
# Optional override if not controlled via Settings UI:
# ENABLE_ITSM=false

# ---------------------------------------------------------------------------
# IoT & Smart Device Controls (enableIoT)
# ---------------------------------------------------------------------------
# Home Assistant base URL (or webhook base URL):
# IOT_WEBHOOK_BASE="http://192.168.1.244:8123"
# Home Assistant Long-Lived Access Token (sent via Authorization: Bearer):
# IOT_API_KEY=""
# Home Assistant entity_id mappings for Office 2x2 grid (auto-calls /api/services/<domain>/toggle):
# IOT_ENTITY_OFFICE_AC="climate.office_greeac"
# IOT_ENTITY_OFFICE_FAN="fan.office_fan"
# IOT_ENTITY_OFFICE_OUTLET="switch.office_socket"
# IOT_ENTITY_OFFICE_LAMP="light.office_olamp"

# ---------------------------------------------------------------------------
# Dual-Inverter Solar Telemetry (enableSolar)
# ---------------------------------------------------------------------------
# Home Assistant entities (auto-scaled from W/kW and Wh/kWh via HA /api/template):
# SOLAR_GEN_ENTITY="sensor.beans_residence_plant_power"
# SOLAR_LOAD_ENTITY="sensor.beans_residence_sensor_83128"
# SOLAR_DAILY_GEN_ENTITY="sensor.beans_residence_daily_yield_of_plant"
# SOLAR_DAILY_LOAD_ENTITY="sensor.beans_residence_daily_load_consumption"
# Optional direct custom JSON endpoint override (defaults to IOT_WEBHOOK_BASE if unset):
# SOLAR_API_URL="http://192.168.1.200:8000/api/solar"
# SOLAR_API_KEY=""
# SOLAR_POLL_INTERVAL_MS="15000"

# ---------------------------------------------------------------------------
# Worklog Time Tracker (enableWorklog)
# ---------------------------------------------------------------------------
# Path to local/mounted Streamlit SQLite database (defaults to ~/.local/share/CatchyPills/worklog.db3 if unset)
# WORKLOG_DB_PATH=""
# Optional explicit SQLite table name override:
# WORKLOG_DB_TABLE="shifts"
# Or HTTP endpoint used when WORKLOG_DB_PATH is unset:
# WORKLOG_API_URL="http://192.168.1.200:8501/api/worklog"
# WORKLOG_API_KEY=""
