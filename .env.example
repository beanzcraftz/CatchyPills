# CatchyPills Personal & Bespoke Integrations Configuration
# Copy to ~/.config/catchypills/.env (recommended) or configure via
# Settings -> Bespoke Integrations (Advanced). Changes save with 0600 permissions.

# ---------------------------------------------------------------------------
# ServiceNow ITSM (enableITSM)
# ---------------------------------------------------------------------------
# Optional override if not controlled via Settings UI:
# ENABLE_ITSM=false

# ---------------------------------------------------------------------------
# IoT & Smart Device Controls (enableIoT)
# ---------------------------------------------------------------------------
# Base webhook URL. Supports "{device}", "%1", "?device=", or appends "/<deviceId>".
# IOT_WEBHOOK_BASE="http://192.168.1.200:8123/api/webhook"
# Optional Bearer token sent via Authorization header:
# IOT_API_KEY=""
# Optional per-device override URLs for built-in tiles:
# IOT_WEBHOOK_SHED_AC=""
# IOT_WEBHOOK_FRONT_GATE=""
# IOT_WEBHOOK_OFFICE_LIGHTS=""
# IOT_WEBHOOK_SHED_LIGHTS=""
# IOT_WEBHOOK_AIR_COMPRESSOR=""
# IOT_WEBHOOK_ALL_OFF=""

# ---------------------------------------------------------------------------
# Dual-Inverter Solar Telemetry (enableSolar)
# ---------------------------------------------------------------------------
# HTTP GET endpoint returning JSON with "current_generation_kw" and "household_consumption_kw"
# SOLAR_API_URL="http://192.168.1.200:8000/api/solar"
# SOLAR_API_KEY=""
# SOLAR_POLL_INTERVAL_MS="15000"

# ---------------------------------------------------------------------------
# Worklog Time Tracker (enableWorklog)
# ---------------------------------------------------------------------------
# Path to local/mounted Streamlit SQLite database (defaults to ~/.local/share/CatchyPills/worklog.db3 if unset)
# WORKLOG_DB_PATH=""
# Optional explicit SQLite table name override:
# WORKLOG_DB_TABLE="shifts"
# Or HTTP endpoint used when WORKLOG_DB_PATH is unset:
# WORKLOG_API_URL="http://192.168.1.200:8501/api/worklog"
# WORKLOG_API_KEY=""
